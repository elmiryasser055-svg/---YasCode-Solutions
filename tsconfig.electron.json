{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist-electron",
    "rootDir": ".",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "declaration": false
  },
  "include": ["frontend/electron/**/*.ts", "backend/**/*.ts", "db/**/*.ts"],
  "exclude": ["**/*.test.ts", "backend/test-utils/**"]
}
