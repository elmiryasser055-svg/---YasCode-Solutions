# .env.example
# انسخ هذا الملف إلى .env محليًا عند التطوير فقط.
# ⚠️ .env لا يُضمَّن أبدًا في نسخة exe النهائية ولا يُرفع لأي مستودع (راجع .gitignore)
# — راجع lib/env.ts في الباك-إند: التطبيق يرفض الإقلاع إن كانت القيم ناقصة/غير صالحة.

# بيئة التشغيل: development | production | test
NODE_ENV=development

# مسار قاعدة البيانات المحلية — اتركه فارغًا في production ليستخدم القيمة الافتراضية
# (مجلد بيانات المستخدم الخاص بـ Electron عبر app.getPath("userData"))
DB_PATH=

# مفتاح تشفير محلي اختياري (32 حرفًا على الأقل) — يُستخدم مستقبلاً لتشفير
# النسخ الاحتياطية إن فُعِّلت هذه الميزة. اتركه فارغًا إن لم تُستخدم بعد.
LOCAL_ENCRYPTION_KEY=

# عدد أيام "قرب انتهاء الصلاحية" الافتراضي (يمكن تعديله لاحقًا من شاشة الإعدادات)
DEFAULT_EXPIRY_WARNING_DAYS=30
