{
  "name": "yascode-supperette",
  "version": "1.0.0",
  "description": "نظام تسيير محلات المواد الغذائية — YasCode Solutions",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "predist": "npm run build:renderer && npm run build:electron",
    "dist:win": "electron-builder --win --x64",
    "audit:check": "npm audit --audit-level=high"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.33.0",
    "bcrypt": "^5.1.1",
    "zod": "^3.23.8",
    "node-thermal-printer": "^4.4.4",
    "bwip-js": "^4.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5",
    "react-i18next": "^15.0.1",
    "i18next": "^23.14.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "drizzle-kit": "^0.24.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^3.4.10",
    "vitest": "^2.0.5",
    "@testing-library/react": "^16.0.0",
    "@playwright/test": "^1.47.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/bcrypt": "^5.0.2"
  },
  "build": {
    "appId": "com.yascode.supperette",
    "productName": "YasCode Supérette",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "drizzle/migrations/**"
    ],
    "files": [
      "dist-electron/**",
      "dist/**"
    ],
    "extraResources": [
      { "from": "drizzle/migrations", "to": "drizzle/migrations" }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
